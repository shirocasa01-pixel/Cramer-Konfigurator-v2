# Vorlage. Kopieren nach `.env.local` (gitignored) und mit den echten Werten
# aus dem Supabase-Dashboard fuellen: Project Settings -> API.
#
# WICHTIG: Beide Werte landen ueber Vite im ausgelieferten Browser-Bundle und sind
# damit oeffentlich. Hier gehoert ausschliesslich der ANON-Key hin, niemals der
# Service-Role-Key. Der Schutz der Daten haengt an den RLS-Policies der Tabelle
# `projects` (siehe supabase/projects-rls.sql).
#
# Fuer das Deployment muessen dieselben zwei Variablen zusaetzlich im Vercel-Projekt
# hinterlegt sein (Settings -> Environment Variables, fuer Production/Preview/
# Development). `.env.local` wird NICHT mit hochgeladen.

VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
